<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pantallaRegistro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111116"
    android:fillViewport="true"
    tools:context="PantallaRegistro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título superior -->
        <TextView
            android:id="@+id/tvRegisterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TituloRegistro"
            android:textColor="#00FFCC"
            android:textSize="32sp"
            android:textStyle="bold|italic"
            android:gravity="center" />

        <!-- Formulario contenedor -->
        <FrameLayout
            android:id="@+id/containerForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neon_container"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Nombre de Usuario -->
                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#00FFCC"
                    android:hint="@string/HintNombreUsuario"
                    android:inputType="textPersonName"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:textSize="16sp" />

                <!-- Correo Electrónico -->
                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#00FFCC"
                    android:hint="@string/HintCorreoElectronico"
                    android:inputType="textEmailAddress"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:textSize="16sp" />

                <!-- Teléfono -->
                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#00FFCC"
                    android:hint="@string/HintTelefono"
                    android:inputType="phone"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:textSize="16sp" />

                <!-- Contraseña -->
                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#00FFCC"
                    android:hint="@string/HintContraseña"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:textSize="16sp" />

                <!-- Repetir Contraseña -->
                <EditText
                    android:id="@+id/etRepeatPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#00FFCC"
                    android:hint="@string/HintRepetirContraseña"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:textSize="16sp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Botón Crear Cuenta -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitRegister"
            android:layout_width="260dp"
            android:layout_height="50dp"
            android:background="@drawable/btn_neon_pink"
            android:text="@string/BotonCrearCuenta"
            android:textColor="#FFFFFF"
            android:textStyle="bold|italic" />

        <!-- Separador Texto -->
        <TextView
            android:id="@+id/tvDivider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/TextoTambien"
            android:textColor="#85858A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Botón Inicio de Sesión con Google -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGoogleRegister"
            android:layout_width="260dp"
            android:layout_height="50dp"
            android:background="@drawable/btn_neon_google"
            android:text="@string/OpcionGoogleRegistro"
            android:textColor="#FFFFFF"
            android:textStyle="bold|italic" />

    </LinearLayout>
</ScrollView>
