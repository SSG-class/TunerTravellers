<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recuperarContrasenaLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111116"
    android:fillViewport="true"
    tools:context=".RecuperacionContrasena">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título superior -->
        <TextView
            android:id="@+id/tvRecoveryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TituloRecuperarContraseña"
            android:textColor="#00FFCC"
            android:textSize="32sp"
            android:textStyle="bold|italic"
            android:gravity="center" />

        <!-- Texto de instrucciones -->
        <TextView
            android:id="@+id/tvRecoveryInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/TextoCorreoRecuperar"
            android:textAlignment="center"
            android:textColor="#85858A"
            android:textSize="14sp" />

        <!-- Formulario contenedor del email -->
        <FrameLayout
            android:id="@+id/containerRecoveryForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neon_container"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Correo Electrónico -->
                <EditText
                    android:id="@+id/etRecoveryEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#00FFCC"
                    android:hint="@string/HintCorreoElectronico"
                    android:inputType="textEmailAddress"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF"
                    android:textSize="16sp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Botón Enviar Código -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitRecovery"
            android:layout_width="260dp"
            android:layout_height="50dp"
            android:background="@drawable/btn_neon_pink"
            android:text="ENVIAR CÓDIGO"
            android:textColor="#FFFFFF"
            android:textStyle="bold|italic" />

        <!-- Separador de texto -->
        <TextView
            android:id="@+id/tvRecoveryDivider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/TextoTambien"
            android:textColor="#85858A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Botón Secundario para Volver al Login -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBackToLogin"
            android:layout_width="260dp"
            android:layout_height="50dp"
            android:background="@drawable/btn_neon_google"
            android:text="VOLVER AL LOGIN"
            android:textColor="#FFFFFF"
            android:textStyle="bold|italic" />

    </LinearLayout>
</ScrollView>
